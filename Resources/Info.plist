<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Murmur</string>
	<key>CFBundleDisplayName</key>
	<string>Murmur</string>
	<!-- Space-free, so `pkill -x Murmur` in the Makefile matches exactly one process and
	     never needs quoting. `pkill -x` is case-sensitive, which is what keeps this from
	     colliding with a lowercase `murmur` binary from another vendor. -->
	<key>CFBundleExecutable</key>
	<string>Murmur</string>
	<!-- Renamed from ai.pivotstudio.murmur-youtube. TCC binds the Accessibility grant to
	     this string, so changing it costs the grant once — `LegacyMigration` carries the
	     preferences and data across, but that one is the OS's to give and cannot be moved.
	     Distinct from any third-party com.murmur.* identifier: separate TCC identity,
	     separate preferences domain, no shared state. -->
	<key>CFBundleIdentifier</key>
	<string>ai.pivotstudio.murmur</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- `releases/latest/download/` is the one GitHub URL that does not move: it redirects
	     to whichever release is newest. A per-tag asset URL would pin every installed copy
	     to the appcast of the version it shipped with, and updates would stop forever. -->
	<key>SUFeedURL</key>
	<string>https://github.com/LioMessiForeverKing/voicetool/releases/latest/download/appcast.xml</string>
	<!-- Public half of the EdDSA update key. The private half lives only in the login
	     keychain that made it and in the SPARKLE_PRIVATE_KEY repository secret. -->
	<key>SUPublicEDKey</key>
	<string>qLhXgUZj3s7uTINjEcBIUo8TJ8q/TddvHfkxtD39NXg=</string>
	<!-- Lets the dashboard's Clear button call back into the app. A file:// page can't
	     write files or talk to a process, but it can follow a custom-scheme link. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.pivotstudio.murmur</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>murmur</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- A regular app: dock icon, app menu, standard windows. The menu bar item remains
	     for status and the hotkey while you're working elsewhere, but it is secondary. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Murmur listens while you hold the push-to-talk key so it can turn your speech into text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Murmur transcribes your speech on-device to insert text where you're typing.</string>
</dict>
</plist>
